# Database
DB_NAME=waypoint
DB_USER=waypoint
DB_PASSWORD=change-me

# Long random string used to sign login tokens (e.g. `openssl rand -base64 48`)
JWT_SECRET=local-development-secret-change-me-123456789

# Frontend origins allowed to call the API (comma separated, wildcards allowed)
CORS_ORIGINS=http://localhost,http://localhost:5173

# Host folder with the competition dataset (never committed)
DATA_PATH=./data

# Load the demo day and demo accounts on first start (needs the dataset above)
SEED_ENABLED=false

# Host ports
API_PORT=8080
WEB_PORT=80

TZ=Asia/Colombo
