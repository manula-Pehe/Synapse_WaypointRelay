# Base URL of the API used by the built app. Empty = same origin (/api via nginx or the Vite proxy).
VITE_API_URL=
# Where `npm run dev` forwards /api (default http://localhost:8080), e.g. the shared dev server.
VITE_API_TARGET=

# Enable local demo sign-in when the backend is unavailable.
VITE_MOCK_AUTH=false
# Enable fictional store workflow data for UI demos when the backend is unavailable.
VITE_MOCK_STORE=false
